# Lokale Firebase-Emulatoren (vite --mode emulator) — keine Secrets, committbar.
# demo-* Projekt-IDs haben keine Verbindung zu echten Firebase-Ressourcen.
# Vite-Priorität: .env.emulator.local > .env.emulator > .env.local > .env,
# daher überschreiben diese Werte die echten aus .env.local.
VITE_USE_EMULATOR=1
VITE_FIREBASE_PROJECT_ID=demo-geschenke
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-geschenke.firebaseapp.com
VITE_FIREBASE_APP_ID=demo
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_STORAGE_BUCKET=demo
VITE_FIREBASE_VAPID_KEY=
