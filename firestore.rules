rules_version = '2';

// Trust-basierte Webapp ohne klassisches Auth.
// Alle Schreiboperationen sind durch das geteilte Passwort im Frontend "geschützt"
// (kein produktiver Schutz — das ist eine bewusste Entscheidung, siehe README).
//
// Diese Rules erlauben Lesen + Schreiben für alle. Wer den API-Key kennt
// (steht im Bundle), kann theoretisch direkt zugreifen. Für den Freundeskreis-
// Use-Case akzeptabel; bei Bedarf später auf App Check umstellen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
