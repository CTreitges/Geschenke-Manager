rules_version = '2';

// Multi-group Trust app, post-Tier-1 hardening:
//
// - All client access requires Firebase Anonymous Auth (request.auth != null).
// - Group data is only readable/writable by users whose anonymous UID is
//   registered as a member at /groups/{groupId}/members/{uid}.
// - The password hash + salt live at /groups/{groupId}/_meta/auth and are
//   strictly off-limits for clients — only Cloud Functions (which run with
//   admin privileges) can read/write them.
// - Group membership is established exclusively via the Cloud Functions
//   `createGroup` and `joinGroup` (they validate the password server-side).
//   A user can self-`delete` their own membership doc to "leave" a group.
// - The top-level /groups collection cannot be listed by clients (no
//   enumeration of group ids). Individual `get` only succeeds if you are
//   a member.
// - /feedback is cross-group, but ownership-gated: a single OWNER (matched
//   by the Google account email) can read/edit/delete ALL feedback; every
//   other authenticated user can only read/edit/delete their own (matched
//   by byUid == request.auth.uid). Create requires the caller to stamp
//   their own UID into byUid.
// - All legacy top-level collections (persons, gifts, …, settings) are
//   denied — they are read-only safety-net backups that the app no longer
//   touches.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(groupId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Läuft die Abstimmung zum Geschenk `giftId`? Wie pollPhase() in
    // functions/src/shared/poll.ts: aktiv und Frist (Server-Uhr) offen.
    function pollRunning(groupId, giftId) {
      let path = /databases/$(database)/documents/groups/$(groupId)/polls/$(giftId);
      return exists(path) && isRunningPoll(get(path).data);
    }

    // Ohne startedAt ist der Beginn unbekannt → gilt als abgelaufen.
    function isRunningPoll(poll) {
      return poll.status == 'active'
        && 'startedAt' in poll
        && pollEnd(poll) > request.time.toMillis();
    }

    // Wie effectiveEndsAt(): endsAt nur, wenn > startedAt (alte Clients lassen
    // beim Neustart ein altes endsAt stehen); sonst startedAt + 48 Std
    // (LEGACY_POLL_DURATION_MS) – auch für Alt-Runden ganz ohne endsAt.
    function pollEnd(poll) {
      return ('endsAt' in poll && poll.endsAt > poll.startedAt)
        ? poll.endsAt
        : poll.startedAt + 172800000;
    }

    // Ganzzahlig, nicht negativ und höchstens `ahead` ms in der Zukunft. Ein
    // extremer Wert ließe sich nicht als Datum formatieren.
    function validTimestamp(value, ahead) {
      return value is int && value >= 0 && value <= request.time.toMillis() + ahead;
    }

    // Poll-Doc: Status active/closed; endsAt höchstens 60 Tage voraus (längste
    // Dauer 1 Woche plus Verlängern), startedAt höchstens 1 Tag (Uhrzeit-Abweichung).
    // Verwerfen = Doc löschen; "none" bleibt erlaubt, weil alte, gecachte
    // Clients so verwerfen (normalizePoll/pollPhase werten es als „kein Poll“).
    function validPoll(data) {
      return data.status in ['active', 'closed', 'none']
        && (!('endsAt' in data) || validTimestamp(data.endsAt, 5184000000))
        && (!('startedAt' in data) || validTimestamp(data.startedAt, 86400000));
    }

    function pollFieldChanged(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function noVotes(data) {
      return data.get('votes', {}).size() == 0;
    }

    // Die Identität ist ein selbst gewähltes Label: Das bindet Stimmen an EINE
    // Person je Mitglied, verhindert aber nicht, die Identität zu wechseln.
    function myPersonId(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('identityPersonId', '');
    }

    function onlyMyVoteChanged(groupId) {
      return request.resource.data.get('votes', {}).diff(resource.data.get('votes', {}))
        .affectedKeys().hasOnly([myPersonId(groupId)]);
    }

    // Stimmen ändern: nur die eigene in der laufenden Runde. Eine neue Runde
    // darf sie leeren, aber nicht vorbelegen.
    function votesUpdateAllowed(groupId) {
      return !pollFieldChanged('votes')
        || (pollFieldChanged('startedAt') && noVotes(request.resource.data))
        || (isRunningPoll(resource.data) && onlyMyVoteChanged(groupId));
    }

    // Ein neues startedAt ist eine neue Runde (Push) – nicht über eine laufende.
    function startedAtUpdateAllowed() {
      return !pollFieldChanged('startedAt') || !isRunningPoll(resource.data);
    }

    function isFeedbackOwner() {
      return request.auth != null
        && request.auth.uid == 't7DmIhxGu9ZniAnmeGVmgEGnW4F2'; // wie FEEDBACK_OWNER_UID in src/lib/feedback-owner.ts
    }

    // Cross-group feedback inbox. Owner sees all; everyone else only sees
    // entries whose byUid matches their own auth uid.
    match /feedback/{id} {
      allow read: if isFeedbackOwner()
        || (request.auth != null && resource.data.byUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if isFeedbackOwner()
        || (request.auth != null && resource.data.byUid == request.auth.uid);
    }

    // Web-Push FCM-Tokens, pro User-UID. Nur der eigene User schreibt/liest;
    // die Cloud Function liest via Admin-SDK und bypasst Rules.
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Group root.
    match /groups/{groupId} {
      // Public-ish fields (defaultBudget, darkMode, createdAt) readable by
      // members. Members can update non-critical settings (darkMode,
      // defaultBudget). Create/delete go through Cloud Functions only.
      allow get: if isMember(groupId);
      allow list: if false;
      allow update: if isMember(groupId);
      allow create, delete: if false;

      // Password hash + salt. Hard no.
      match /_meta/{doc} {
        allow read, write: if false;
      }

      // Membership records.
      match /members/{uid} {
        // Members of the group can see who else is in (useful for future
        // UI). Reading one's own membership is also allowed before being
        // a full member (sanity-check during boot).
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if isMember(groupId);
        allow create: if false; // only via createGroup / joinGroup
        // Updates erlaubt für den eigenen Member-Eintrag, aber nur für
        // die Push-Schalter (notifyStack = Geburtstage, notifyPolls =
        // Abstimmungen) und das identityPersonId-Feld (Cloud-Sync der
        // "Wer bin ich?"-Auswahl). Alles andere (joinedAt, uid) bleibt
        // immutable.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notifyStack", "identityPersonId", "notifyPolls"]);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Group data — only members.
      match /persons/{doc}      { allow read, write: if isMember(groupId); }
      match /gifts/{doc}        { allow read, write: if isMember(groupId); }
      // Ideen: Anlegen ist gesperrt, solange die Abstimmung des Geschenks
      // läuft – damit alle über dasselbe abstimmen (greift auch bei alten,
      // gecachten App-Versionen). Der Batch von deleteGift (Ideen + Poll
      // löschen) bleibt möglich. Umhängen geht nur zwischen Geschenken ohne
      // laufende Abstimmung (deduplicateOpenGifts verschiebt Ideen).
      match /suggestions/{doc}  {
        allow read, delete: if isMember(groupId);
        allow update: if isMember(groupId)
          && (request.resource.data.get('giftId', '') == resource.data.get('giftId', '')
            || (!pollRunning(groupId, resource.data.giftId)
              && !pollRunning(groupId, request.resource.data.giftId)));
        allow create: if isMember(groupId)
          && !pollRunning(groupId, request.resource.data.giftId);
      }
      match /wishlist/{doc}     { allow read, write: if isMember(groupId); }
      // Stimmen ändern geht nur, solange die Runde läuft – auch alte Clients
      // oder falsch gehende Uhren kippen so kein beendetes Ergebnis.
      match /polls/{doc}        {
        allow read, delete: if isMember(groupId);
        allow create: if isMember(groupId) && validPoll(request.resource.data)
          && noVotes(request.resource.data);
        allow update: if isMember(groupId) && validPoll(request.resource.data)
          && votesUpdateAllowed(groupId) && startedAtUpdateAllowed();
      }

      // Archiv-Verlauf für Restore. Schreibt die archiveGroupDocChange-
      // Cloud-Function via Admin-SDK (bypasst Rules). Members dürfen
      // ausschließlich lesen und löschen (z.B. zum „Verlauf bereinigen").
      // Restore = Member schreibt die archivierten Felder zurück auf das
      // Original-Doc, dafür ist hier kein write nötig.
      match /_archive/{doc}     {
        allow read, delete: if isMember(groupId);
        allow create, update: if false;
      }

      // Push-Idempotenz-Marker (_push) und Emulator-Versandprotokoll
      // (_debugPush) schreiben nur Cloud Functions via Admin-SDK. Kein
      // Client-Zugriff — auch nicht für Mitglieder (wäre ohnehin Default-
      // Deny, steht hier zur Klarheit). deleteGroup löscht sie rekursiv mit.
      match /_push/{doc}        { allow read, write: if false; }
      match /_debugPush/{doc}   { allow read, write: if false; }
    }

    // Legacy top-level collections from the pre-multi-group era — locked.
    match /persons/{doc}      { allow read, write: if false; }
    match /gifts/{doc}        { allow read, write: if false; }
    match /suggestions/{doc}  { allow read, write: if false; }
    match /wishlist/{doc}     { allow read, write: if false; }
    match /polls/{doc}        { allow read, write: if false; }
    match /settings/{doc}     { allow read, write: if false; }

    // Zähler des joinGroup-Rate-Limits (functions/src/rateLimit.ts) je UID
    // bzw. Client-IP. Nur die Function via Admin-SDK; sonst könnte ein
    // Client seine Sperre zurücksetzen oder fremde IPs/UIDs auslesen.
    match /_rateLimits/{doc}    { allow read, write: if false; }

    // Birthday-reminder magic links. Only Cloud Functions read/write these.
    match /magic_tokens/{token} { allow read, write: if false; }

    // Outgoing-mail queue, drained by the Trigger Email extension.
    match /mail/{id}            { allow read, write: if false; }
  }
}
