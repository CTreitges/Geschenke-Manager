{
  "name": "geschenke-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "generate-pwa-assets": "pwa-assets-generator",
    "preemu:shots": "node e2e/emu-cleanup.mjs",
    "emu:shots": "node e2e/run-emulators.mjs --only auth,firestore,functions --project demo-geschenke \"node e2e/emu-run.mjs\"",
    "postemu:shots": "node e2e/emu-cleanup.mjs",
    "pretest:rules": "node e2e/emu-cleanup.mjs",
    "test:rules": "node e2e/run-emulators.mjs --only firestore --project demo-geschenke \"vitest run --config vitest.rules.config.ts\"",
    "posttest:rules": "node e2e/emu-cleanup.mjs",
    "pree2e": "node e2e/emu-cleanup.mjs && npm --prefix functions run build",
    "e2e": "node e2e/run-emulators.mjs --only auth,firestore,functions --project demo-geschenke \"npx playwright test -c e2e/playwright.config.ts\"",
    "poste2e": "node e2e/emu-cleanup.mjs",
    "check:design": "node e2e/check-design.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^10.13.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
